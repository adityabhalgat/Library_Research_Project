# ==============================================================================
# BE Project Critique Pipeline - Environment Configuration
# ==============================================================================
# Uses local Ollama for LLM inference (no cloud API keys needed)
# 
# Prerequisites:
#   1. Install Ollama: https://ollama.ai
#   2. Pull a vision model: ollama pull llava
#   3. Copy this file to .env: cp .env.sample .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Ollama Configuration
# ------------------------------------------------------------------------------

# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use (must be pulled first: ollama pull llava)
# Vision-capable models: llava, llava-llama3, bakllava, llava-phi3
# Text-only models: llama3.2, mistral, phi3
OLLAMA_MODEL=llava

# Optional: separate model for Two-Model judge strategy
# Leave empty to use the same model as judge
OLLAMA_JUDGE_MODEL=

# ------------------------------------------------------------------------------
# Default Settings
# ------------------------------------------------------------------------------

DEFAULT_PROMPT_TECHNIQUE=cot

OUTPUT_DIR=./outputs

# Optional: pair-wise prompt matrix for parameter analysis
# Supports .xlsx/.xlsm/.xltx/.xltm or .csv
PARAMETER_PROMPT_TABLE_PATH=parameters.xlsx

# Optional: sheet name in Excel prompt table (leave blank to use active sheet)
PARAMETER_PROMPT_TABLE_SHEET=

# ------------------------------------------------------------------------------
# Generation Configuration
# ------------------------------------------------------------------------------

MAX_TOKENS=4096

TEMPERATURE=0.7
